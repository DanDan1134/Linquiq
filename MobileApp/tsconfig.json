{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2017",
    "lib": ["ES2017", "ES2020"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", "react-native.d.ts", "types/env.d.ts"]
}
